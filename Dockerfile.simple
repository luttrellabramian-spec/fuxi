# 伏羲引擎 v0.2.5 - 单文件 Docker 构建
# 使用：docker build -t fuxi:v0.2.5 . && docker run fuxi:v0.2.5

FROM python:3.11-slim

LABEL maintainer="Fuxi Team"
LABEL version="v0.2.5"

# ── 环境变量 ─────────────────────────────────────────────
ENV LLM_API_KEY=""
ENV LLM_BASE_URL=""
ENV DEFAULT_MODEL="qwen3.6-plus"
ENV GRPC_PORT=50051
ENV HTTP_PORT=18789
ENV AUTH_ENABLED=true

# ── 系统依赖 ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm curl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g typescript 2>/dev/null || true

# ── Python 依赖 ─────────────────────────────────────────
WORKDIR /app

COPY python/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt 2>&1 | tail -5

# ── Python 源码 ─────────────────────────────────────────
COPY python/src ./python/src
COPY proto ./proto
COPY proto/generated/python ./proto/generated/python

# ── TypeScript 网关（可选：不编译则用纯 Node 替代）──────
# 如果需要网关，去掉下面注释并添加 Node.js 网关构建
# COPY typescript ./typescript
# WORKDIR /app/typescript && npm install && npx tsc

# ── 端口 ────────────────────────────────────────────────
EXPOSE 50051 18789

# ── 启动脚本 ───────────────────────────────────────────
COPY start.sh ./start.sh
RUN chmod +x start.sh

CMD ["./start.sh"]
