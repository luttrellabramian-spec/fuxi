# 伏羲引擎环境变量配置示例
# 复制此文件为 .env 并填入真实值

# LLM API 配置（必填，选择一种即可）
# MiniMax
LLM_API_KEY=sk-your-minimax-key-here
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7

# 通义千问（替换上方对应的值）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-plus

# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.1

# OpenAI 兼容（本地模型）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5

# 超时配置（可选，默认值如下）
# LLM_TIMEOUT_CONNECT=5
# LLM_TIMEOUT_READ=30
# LLM_MAX_RETRIES=3

# 服务端口（可选）
# HTTP_PORT=18789
# GRPC_PORT=50051

# 安全选项
# AUTH_ENABLED=false
# RATE_LIMIT_MAX=100
